---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import Callout from "astro-theme-university/components/Callout.astro";
import ContentLayout from "../../layouts/SiteContentLayout.astro";
import MarkingModel from "../../components/MarkingModel.astro";
import { formatCourseDueDate } from "../../lib/dates";
import { heroForSlug } from "../../lib/hero-images";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const assessments = await getPublishedCollection("assessments");
  return assessments.map((assessment) => ({
    params: { slug: assessment.id },
    props: { assessment },
  }));
}

const { assessment } = Astro.props;
const { Content } = await render(assessment);
// Assessments aren't week-numbered, so hash the slug instead: still stable
// per page (the same brief keeps the same image across builds), just not
// derivable from a week.
const hero = heroForSlug(assessment.id);
---

<ContentLayout
  title={assessment.data.title}
  description={assessment.data.description}
  heroImage={hero.image}
  heroImageAlt={hero.alt}
  {...siteConfig}
>
  {
    assessment.data.draft && (
      <Callout type="warning">
        <p>
          <strong>Draft.</strong> This brief is still being finalised and may change.
        </p>
      </Callout>
    )
  }
  {/* The time is printed here, not just the date: every `due:` in the
      collection is a midday deadline, and a date-only "11 May 2026" reads as
      end-of-day to anyone who takes it literally. The index grid stays
      date-only — see the note on `.assessment-stat` in AssessmentsGrid. */}
  <p>
    <strong>Due:</strong> {formatCourseDueDate(assessment.data.due)} <span class="due-zone">Canberra time</span> ·
    <strong>Weight:</strong> {assessment.data.weight}%
  </p>
  <Content />
  <SpecList spec={assessment.data.spec}>
    The brief poses the problem and leaves room for a response. The spec is the
    fixed part: what a marker checks. Some lines can be checked mechanically;
    the rest call for judgement.
  </SpecList>
  {assessment.data.marking && <MarkingModel marking={assessment.data.marking} />}
  <RelatedContent entry={assessment} collections={graphCollections} />
</ContentLayout>

<style>
  /* Secondary to the deadline it qualifies, but present: a student abroad
     needs to know which clock the time is on, and it should not compete with
     the date and weight either side of it. */
  .due-zone {
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-sm);
  }
</style>
