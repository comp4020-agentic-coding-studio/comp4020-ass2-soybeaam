---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "../layouts/SiteContentLayout.astro";
import heroImage from "../assets/images/hero-home.avif";
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";

const [lectures, sessions] = await Promise.all([
  getPublishedCollection("lectures"),
  getPublishedCollection("sessions"),
]);

type WeekRow = {
  week: number;
  lecture?: { title: string; href: string; slides?: string };
  session?: { title: string; href: string };
};

const weeks = new Map<number, WeekRow>();
for (const entry of lectures) {
  const week = (entry.data as { week: number }).week;
  weeks.set(week, {
    ...weeks.get(week),
    week,
    lecture: {
      title: entry.data.title,
      href: withBase(`/lectures/${entry.id}/`),
      slides: entry.data.slides,
    },
  });
}
for (const entry of sessions) {
  const week = (entry.data as { week: number }).week;
  weeks.set(week, {
    ...weeks.get(week),
    week,
    session: { title: entry.data.title, href: withBase(`/sessions/${entry.id}/`) },
  });
}
const orderedWeeks = [...weeks.values()].sort((a, b) => a.week - b.week);
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A speech bubble breaking apart mid-sentence, its words scattering as flat gold rectangles, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    You will take excuses apart. Every week you read or watch a real one:
    a late-work email, a corporate apology, a courtroom defense, a toddler's
    alibi, a chatbot's confident wrong answer. You then work out what it is
    actually doing: which blame it is moving, and where. By the end you
    design and defend an original excuse of your own, built to survive
    cross-examination.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone who has ever been unconvinced by an apology and wanted to know
    why. No prior rhetoric, psychology, or law background is assumed, because the
    course builds its own vocabulary from week 1. It suits students in
    communications, law, psychology, design, or anyone who negotiates,
    manages, or apologises for a living.
  </p>

  <h2>Week by week</h2>
  <ol class="week-list">
    {
      orderedWeeks.map(({ week, lecture, session }) => (
        <li class="week-row">
          <details class="week-details" open={week === 1}>
            <summary class="week-number">Week {week}</summary>
            <ul class="week-items">
              {lecture && (
                <li>
                  <a href={lecture.href}>Lecture: {lecture.title}</a>
                  {lecture.slides && (
                    <ul class="week-subitems">
                      <li>
                        <a href={withBase(lecture.slides)}>Slides</a>
                      </li>
                    </ul>
                  )}
                </li>
              )}
              {session && (
                <li>
                  <a href={session.href}>
                    {sessionLabels.singular}: {session.title}
                  </a>
                </li>
              )}
            </ul>
          </details>
        </li>
      ))
    }
  </ol>

  <h2>Where to go next</h2>
  <CardGrid>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--at-spacing-sm);
    margin-block: 0 var(--at-spacing-xl);
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: var(--at-spacing-xs) var(--at-spacing-sm);
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: var(--at-font-size-sm);
  }

  /* One bordered panel of hairline-separated rows, the same idiom the
     lecture/session/assessment index pages use (.at-card-grid in brand.css)
     — twelve separately-boxed, separately-shaded weeks read as a striped
     ladder and made the homepage the odd page out. */
  .week-list {
    list-style: none;
    margin: 0 0 var(--at-spacing-xl);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--at-divider);
    border-radius: var(--at-radius-panel);
    overflow: hidden;
  }

  .week-row + .week-row {
    border-block-start: 1px solid var(--at-divider);
  }

  .week-row:has(.week-details[open]) {
    background: var(--at-bg-alt);
  }

  .week-details {
    padding: var(--at-spacing-sm) var(--at-spacing-md);
  }

  .week-number {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-xs);
    font-weight: 600;
    color: var(--at-primary);
    cursor: pointer;
    list-style: none;
  }

  .week-number::-webkit-details-marker {
    display: none;
  }

  .week-number::before {
    content: "▸";
    display: inline-block;
    font-size: 0.8em;
    transition: transform 0.15s ease;
  }

  .week-details[open] > .week-number::before {
    transform: rotate(90deg);
  }

  .week-items {
    list-style: none;
    margin: var(--at-spacing-xs) 0 0;
    padding-inline-start: var(--at-spacing-md);
    border-inline-start: 2px solid color-mix(in srgb, var(--at-primary) 30%, transparent);
    display: flex;
    flex-direction: column;
    gap: var(--at-spacing-xs);
  }

  .week-items li {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-xs);
    flex-wrap: wrap;
  }

  /* The lecture and the workshop are two different commitments in a week, but
     an 0.25rem gap ran them together as one four-line block. A rule and real
     space between them makes the week's two halves separable at a glance.
     `> li` so the nested slides list is not also split off from its lecture. */
  .week-items > li + li {
    margin-block-start: var(--at-spacing-sm);
    padding-block-start: var(--at-spacing-sm);
    border-block-start: 1px solid var(--at-divider);
  }

  .week-subitems {
    list-style: none;
    margin: var(--at-spacing-xs) 0 0;
    padding-inline-start: var(--at-spacing-md);
    border-inline-start: 2px solid var(--at-divider);
    flex-basis: 100%;
  }

  .week-subitems a {
    font-size: var(--at-font-size-sm);
  }

  .week-items a,
  .week-subitems a {
    color: var(--at-text);
    text-decoration: none;
  }

  .week-items a:hover,
  .week-items a:focus-visible {
    text-decoration: underline;
  }

  @media (width < 640px) {
    .week-list {
      margin-inline: calc(-1 * var(--page-pad));
      border-inline: none;
      border-radius: 0;
    }
  }
</style>
