---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "../../layouts/SiteContentLayout.astro";
import Icon from "astro-theme-university/components/Icon.astro";
import { siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const people = await getPublishedCollection("people");
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);

// Map the role enum (convenor|tutor|guest|other) to display labels rather than
// rendering the raw lowercase value.
const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "",
};
const roleLabel = person.data.role ? roleLabels[person.data.role] : undefined;
// Astro's generated type does not retain the image/alt refinement relationship,
// so narrow the alt at the rendering boundary as well.
const rawPhotoAlt = (person.data as { photoAlt?: unknown }).photoAlt;
const photoAlt = typeof rawPhotoAlt === "string" ? rawPhotoAlt : "";
// Every page owes a description --- it is what a search result and a shared
// link show underneath the title.
const description = person.data.description;
---

<ContentLayout
  title={person.data.title}
  description={description}
  heroImage={person.data.photo ?? undefined}
  heroImageAlt={photoAlt}
  {...siteConfig}
>
  <ul class="person-facts">
    {roleLabel && (
      <li>
        <Icon name="badge-check" size="1.1rem" />
        <span class="person-fact-label">Role</span>
        <span class="person-fact-value">{roleLabel}</span>
      </li>
    )}
    {person.data.affiliation && (
      <li>
        <Icon name="building" size="1.1rem" />
        <span class="person-fact-label">Affiliation</span>
        <span class="person-fact-value">{person.data.affiliation}</span>
      </li>
    )}
    {person.data.email && (
      <li>
        <Icon name="mail" size="1.1rem" />
        <span class="person-fact-label">Email</span>
        <a class="person-fact-value" href={`mailto:${person.data.email}`}>{person.data.email}</a>
      </li>
    )}
    {person.data.url && (
      <li>
        <Icon name="internet" size="1.1rem" />
        <span class="person-fact-label">Web</span>
        <a class="person-fact-value" href={person.data.url}>{person.data.url}</a>
      </li>
    )}
    {person.data.contact && (
      <li>
        <Icon name="phone" size="1.1rem" />
        <span class="person-fact-label">Contact</span>
        <span class="person-fact-value">{person.data.contact}</span>
      </li>
    )}
  </ul>

  <Content />
</ContentLayout>

<style>
  /* A row of labelled facts with an icon each, rather than a bare <dl> —
     matches the card language used elsewhere on the site (see SlidesLink)
     instead of looking like unstyled browser-default definition list markup. */
  .person-facts {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-block: var(--at-spacing-lg, 1.5rem);
    padding: 0;
    list-style: none;
    border: 1px solid var(--at-divider);
    border-radius: var(--at-radius-panel, 0.5rem);
    overflow: hidden;
  }

  .person-facts li {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-sm, 0.75rem);
    padding: var(--at-spacing-sm, 0.75rem) var(--at-spacing-md, 1rem);
    background: var(--at-bg, #fff);
  }

  .person-facts li + li {
    border-block-start: 1px solid var(--at-divider);
  }

  .person-facts :global(svg) {
    flex: none;
    color: var(--at-primary);
  }

  .person-fact-label {
    flex: none;
    inline-size: 6rem;
    font-size: var(--at-font-size-sm, 0.85rem);
    font-weight: 600;
    color: var(--at-text-secondary);
  }

  .person-fact-value {
    min-width: 0;
    overflow-wrap: break-word;
    color: inherit;
  }

  a.person-fact-value {
    text-decoration: underline;
  }

  @media (width <= 480px) {
    .person-facts li {
      flex-wrap: wrap;
    }

    .person-fact-label {
      inline-size: auto;
    }
  }
</style>
