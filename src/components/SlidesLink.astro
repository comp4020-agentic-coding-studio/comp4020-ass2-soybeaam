---
import Icon from "astro-theme-university/components/Icon.astro";
import { withBase } from "astro-theme-university/url";

export interface Props {
  href: string;
  label?: string;
}

const { href, label = "Slides" } = Astro.props;
const resolved = withBase(href);
const panelId = `slides-panel-${href.replace(/[^a-z0-9]/gi, "-")}`;
---

<div class="slides-block" data-slides-block data-href={resolved}>
  <div class="slides-block-controls">
    <button type="button" class="slides-toggle" aria-expanded="false" aria-controls={panelId}>
      <span class="slides-toggle-icon">
        <Icon name="presentation" size="1.15rem" />
      </span>
      <span class="slides-toggle-text">
        <span class="slides-toggle-title">{label}</span>
        <span class="slides-toggle-subtitle">Open the interactive deck</span>
      </span>
    </button>
    <a
      class="slides-newtab"
      href={resolved}
      target="_blank"
      rel="noopener"
      title="Open in new tab"
      aria-label="Open slides in a new tab"
    >
      <Icon name="open-new-window" size="1rem" />
    </a>
  </div>
  <div class="slides-panel" id={panelId} hidden>
    <div class="slides-panel-inner">
      <button type="button" class="slides-close" aria-label="Close slides">
        <Icon name="xmark" size="1.1rem" />
      </button>
    </div>
  </div>
</div>

<script>
  function setupSlidesBlocks() {
    for (const block of document.querySelectorAll<HTMLElement>("[data-slides-block]")) {
      if (block.dataset.slidesReady === "true") continue;
      block.dataset.slidesReady = "true";

      const href = block.dataset.href;
      const toggle = block.querySelector<HTMLButtonElement>(".slides-toggle");
      const panel = block.querySelector<HTMLElement>(".slides-panel");
      const closeButton = block.querySelector<HTMLButtonElement>(".slides-close");
      const panelInner = block.querySelector<HTMLElement>(".slides-panel-inner");
      if (!href || !toggle || !panel || !closeButton || !panelInner) continue;

      const storageKey = `slides-position:${href}`;
      let iframe: HTMLIFrameElement | null = null;

      const saveHash = () => {
        try {
          const hash = iframe?.contentWindow?.location.hash ?? "";
          if (hash) localStorage.setItem(storageKey, hash);
        } catch {
          // Cross-origin or unavailable — position just won't be restored.
        }
      };

      const openPanel = () => {
        panel.hidden = false;
        document.body.classList.add("slides-panel-open");
        toggle.setAttribute("aria-expanded", "true");
        if (!iframe) {
          iframe = document.createElement("iframe");
          iframe.className = "slides-iframe";
          iframe.title = "Slide deck";
          let savedHash = "";
          try {
            savedHash = localStorage.getItem(storageKey) ?? "";
          } catch {
            // ignore
          }
          iframe.src = href + savedHash;
          panelInner.append(iframe);
          iframe.addEventListener("load", () => {
            try {
              iframe?.contentWindow?.addEventListener("hashchange", saveHash);
            } catch {
              // Cross-origin — no way to track slide position from here.
            }
          });
        }
      };

      const closePanel = () => {
        saveHash();
        panel.hidden = true;
        document.body.classList.remove("slides-panel-open");
        toggle.setAttribute("aria-expanded", "false");
      };

      toggle.addEventListener("click", () => {
        if (panel.hidden) openPanel();
        else closePanel();
      });

      closeButton.addEventListener("click", closePanel);

      panel.addEventListener("click", (event) => {
        if (event.target === panel) closePanel();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !panel.hidden) closePanel();
      });

      window.addEventListener("beforeunload", saveHash);
    }
  }

  setupSlidesBlocks();
  document.addEventListener("astro:page-load", setupSlidesBlocks);
</script>

<style>
  .slides-block {
    display: inline-flex;
    flex-direction: column;
    width: 100%;
  }

  .slides-block-controls {
    display: flex;
    align-items: stretch;
    gap: var(--at-spacing-sm, 0.75rem);
  }

  /* A small card rather than a bare button: an icon chip, a title/subtitle
     pair, so the slide deck reads as a distinct piece of content on the page
     instead of one anonymous control among the prose. */
  .slides-toggle {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-sm, 0.75rem);
    flex: 1 1 auto;
    min-width: 0;
    text-align: start;
    font: inherit;
    text-decoration: none;
    border: 1px solid var(--at-divider);
    border-radius: var(--at-radius-panel, 0.5rem);
    padding: var(--at-spacing-sm, 0.75rem);
    background: var(--at-bg, #fff);
    color: inherit;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .slides-toggle:hover,
  .slides-toggle:focus-visible {
    border-color: var(--at-primary);
    box-shadow: 0 0.125rem 0.5rem rgba(0, 0, 0, 0.08);
  }

  .slides-toggle-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: var(--at-radius-inner, 0.375rem);
    background: color-mix(in srgb, var(--at-primary) 14%, transparent);
    color: var(--at-primary);
  }

  .slides-toggle-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .slides-toggle-title {
    font-weight: 600;
  }

  .slides-toggle-subtitle {
    font-size: var(--at-font-size-sm, 0.85rem);
    color: var(--at-text-secondary);
  }

  .slides-toggle[aria-expanded="true"] {
    background: color-mix(in srgb, var(--at-primary) 8%, var(--at-bg, #fff));
    border-color: var(--at-primary);
  }

  .slides-toggle[aria-expanded="true"] .slides-toggle-icon {
    background: var(--at-primary);
    color: var(--at-on-primary, #fff);
  }

  .slides-newtab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    inline-size: 2.5rem;
    border: 1px solid var(--at-divider);
    border-radius: var(--at-radius-inner, 0.375rem);
    color: var(--at-text-secondary);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .slides-newtab:hover,
  .slides-newtab:focus-visible {
    border-color: var(--at-primary);
    color: var(--at-primary);
  }

  .slides-panel[hidden] {
    display: none;
  }

  .slides-panel {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: min(3vh, 1.5rem) min(3vw, 1.5rem);
    background: rgba(0, 0, 0, 0.55);
  }

  .slides-panel-inner {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 96vw;
    max-height: 96vh;
    aspect-ratio: 16 / 9;
  }

  .slides-close {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-end: 0.5rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    border-radius: 0.35rem;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
  }

  .slides-close:hover,
  .slides-close:focus-visible {
    background: rgba(255, 255, 255, 0.3);
  }

  :global(.slides-iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 0.5rem;
    background: #fff;
  }

  @media (width <= 640px) {
    .slides-panel {
      padding: 0;
    }

    .slides-panel-inner {
      max-width: 100vw;
      max-height: 100vh;
      aspect-ratio: auto;
    }

    :global(.slides-iframe) {
      border-radius: 0;
      border: none;
    }
  }
</style>
