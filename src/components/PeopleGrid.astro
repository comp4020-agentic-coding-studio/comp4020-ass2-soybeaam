---
import { getPublishedCollection } from "astro-course-university/content";
import { Image } from "astro:assets";
import { withBase } from "astro-theme-university/url";

const people = await getPublishedCollection("people");

// Sectioned rather than one flat list, so a visitor can jump straight to
// "who teaches this" or "who's actually taking it" instead of scanning past
// everyone else first.
const sections = [
  { role: "convenor", heading: "Convenor" },
  { role: "tutor", heading: "Tutors" },
];

const linkableRoles = new Set(["convenor", "tutor"]);

const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  tutor: "Tutor",
};

// photoAlt rides the schema's passthrough (definePeopleCollection has no
// extension point), so it needs a cast out of the generated types.
function photoAlt(data: unknown): string | undefined {
  const alt = (data as { photoAlt?: unknown }).photoAlt;
  return typeof alt === "string" ? alt : undefined;
}

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join("");
}

const bySection = sections
  .map((section) => ({
    ...section,
    people: people
      .filter((person) => person.data.role === section.role)
      .sort((a, b) => a.data.title.localeCompare(b.data.title)),
  }))
  .filter((section) => section.people.length > 0);
---

{
  bySection.map((section) => (
    <section class="people-section">
      <h2>{section.heading}</h2>
      <ul class="people-list">
        {section.people.map((person) => {
          const href = linkableRoles.has(person.data.role) ? withBase(`/people/${person.id}/`) : undefined;
          const Row = href ? "a" : "div";
          return (
            <li class="people-row">
              <Row href={href} class="people-row-link">
                <span class="people-avatar" aria-hidden={person.data.photo ? "false" : "true"}>
                  {person.data.photo ? (
                    <Image src={person.data.photo} alt={photoAlt(person.data) ?? ""} width={40} height={40} />
                  ) : (
                    initials(person.data.title)
                  )}
                </span>
                <span class="people-name">{person.data.title}</span>
                <span class="people-email">{person.data.email ?? ""}</span>
                <span class="people-role">{roleLabels[person.data.role] ?? person.data.role}</span>
              </Row>
            </li>
          );
        })}
      </ul>
    </section>
  ))
}

<style>
  .people-section + .people-section {
    margin-block-start: var(--at-spacing-lg);
  }

  .people-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--at-divider);
    border-radius: var(--at-radius-panel);
    overflow: hidden;
  }

  .people-row + .people-row {
    border-block-start: 1px solid var(--at-divider);
  }

  .people-row-link {
    display: grid;
    grid-template-columns: 2.5rem 2fr 2fr 1fr;
    align-items: center;
    gap: var(--at-spacing-md);
    padding: var(--at-spacing-sm) var(--at-spacing-md);
    color: inherit;
    text-decoration: none;
  }

  a.people-row-link:hover,
  a.people-row-link:focus-visible {
    background: var(--at-bg-alt);
    text-decoration: underline;
  }

  .people-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
    overflow: hidden;
    background: var(--at-primary);
    color: #fff;
    font-size: var(--at-font-size-sm);
    font-weight: 600;
  }

  .people-avatar :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .people-email {
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-sm);
    overflow-wrap: anywhere;
  }

  .people-role {
    text-align: end;
    font-size: var(--at-font-size-sm);
  }

  @media (width < 640px) {
    /* The side border and corner radius only cost width on a phone, and
       People shouldn't be the one index page that still sits inset. */
    .people-list {
      margin-inline: calc(-1 * var(--page-pad));
      border-inline: none;
      border-radius: 0;
    }

    .people-row-link {
      grid-template-columns: 2.5rem 1fr;
      grid-template-areas:
        "avatar name"
        "avatar email"
        "avatar role";
      /* The md gap is a column gap on desktop; once the three fields stack it
         also becomes the row gap and blows one person up to ~5rem tall. */
      gap: 0.15rem var(--at-spacing-sm);
    }
    .people-avatar {
      grid-area: avatar;
      /* Vertically centred against a 3-row stack reads as floating; pin it to
         the name it belongs to. */
      align-self: start;
    }
    .people-name {
      grid-area: name;
    }
    .people-email {
      grid-area: email;
    }
    .people-role {
      grid-area: role;
      text-align: start;
      color: var(--at-text-muted);
    }
  }
</style>
