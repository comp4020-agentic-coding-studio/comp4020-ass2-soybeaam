---
import { getPublishedCollection } from "astro-course-university/content";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import WeekFilter from "./WeekFilter.astro";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";

const assessments = await getPublishedCollection("assessments");
const visible = assessments.sort((a, b) => a.data.week - b.data.week);
const weeks = [...new Set(visible.map((assessment) => assessment.data.week))].sort((a, b) => a - b);
---

<WeekFilter scope="assessments" weeks={weeks} />
<div data-week-filter-target="assessments">
  <CardGrid columns={1}>
    {
      visible.map((assessment, index) => (
        <div class="week-filter-item" data-week={assessment.data.week}>
          <p class="assessment-heading">Assignment {index + 1}</p>
          <a class="assessment-row" href={withBase(`/assessments/${assessment.id}/`)}>
            <div class="assessment-body">
              <h2 class="assessment-title">{assessment.data.title}</h2>
              {assessment.data.description && <p>{assessment.data.description}</p>}
            </div>
            <div class="assessment-stat">
              {assessment.data.weight != null && <span class="assessment-weight">{assessment.data.weight}%</span>}
              <span class="assessment-due">Due {formatCourseDate(assessment.data.due)}</span>
              {assessment.data.draft && <span class="assessment-draft">Draft</span>}
            </div>
          </a>
        </div>
      ))
    }
  </CardGrid>
</div>

<style>
  .assessment-heading {
    margin: var(--at-spacing-sm) var(--at-spacing-md) 0;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--at-primary, #b97d1c);
  }

  .assessment-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--at-spacing-md);
    padding: var(--at-spacing-xs) var(--at-spacing-md) var(--at-spacing-sm);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .assessment-row:hover,
  .assessment-row:focus-visible {
    background: rgba(185, 125, 28, 0.08);
  }

  .assessment-stat {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    min-width: 7.5rem;
    padding-inline-start: var(--at-spacing-md);
    border-inline-start: 1px solid var(--at-divider);
    text-align: right;
  }

  .assessment-weight {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--at-primary, #b97d1c);
  }

  .assessment-due {
    font-size: 0.85rem;
    color: var(--at-text-secondary);
  }

  .assessment-draft {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--at-text-secondary);
  }

  .assessment-body {
    flex: 1;
    min-width: 0;
  }

  .assessment-title {
    font-size: 1rem;
    margin: 0;
  }

  .assessment-body p {
    margin: var(--at-spacing-2xs, 0.25rem) 0 0;
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }

  @media (width <= 640px) {
    .assessment-row {
      flex-direction: column;
      align-items: stretch;
    }

    .assessment-stat {
      flex-direction: row;
      align-items: center;
      gap: var(--at-spacing-sm);
      min-width: 0;
      padding-inline-start: 0;
      padding-block-start: var(--at-spacing-xs);
      border-inline-start: none;
      border-block-start: 1px solid var(--at-divider);
      align-self: stretch;
      text-align: left;
    }
  }
</style>
