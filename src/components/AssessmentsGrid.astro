---
import { getPublishedCollection } from "astro-course-university/content";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";

const assessments = await getPublishedCollection("assessments");
const visible = assessments.sort((a, b) => a.data.week - b.data.week);
---

<div data-week-filter-target="assessments">
  {/* No `columns` prop: brand.css renders every .at-card-grid as a single
      bordered column of rows, so a column count here would be ignored. */}
  <CardGrid>
    {
      visible.map((assessment, index) => (
        <div class="week-filter-item" data-week={assessment.data.week}>
          <p class="row-eyebrow">Assignment {index + 1}</p>
          <a class="assessment-row" href={withBase(`/assessments/${assessment.id}/`)}>
            <div class="assessment-body">
              <h2 class="assessment-title">{assessment.data.title}</h2>
              {assessment.data.description && <p>{assessment.data.description}</p>}
            </div>
            <div class="assessment-stat">
              {assessment.data.weight != null && <span class="assessment-weight">{assessment.data.weight}%</span>}
              <span class="assessment-due">Due {formatCourseDate(assessment.data.due)}</span>
              {assessment.data.draft && <span class="assessment-draft">Draft</span>}
            </div>
          </a>
        </div>
      ))
    }
  </CardGrid>
</div>

<style>
  /* No padding here on purpose — `.row-eyebrow + .assessment-row` in
     brand.css supplies it, shared with the lecture/workshop grids. */
  .assessment-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--at-spacing-md);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .assessment-row:hover,
  .assessment-row:focus-visible {
    background: color-mix(in srgb, var(--at-primary) 8%, transparent);
  }

  .assessment-stat {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--at-spacing-xs);
    /* A fixed width, not `min-width`: with a minimum, the longest due date
       ("Due 27 April 2026") widens its own row only, so each row's divider
       rule landed at a different x and the column read as ragged. A fixed
       track puts every divider and every right edge on one line. 9.5rem
       clears the longest string at --at-font-size-sm with room to spare. */
    inline-size: 9.5rem;
    padding-inline-start: var(--at-spacing-md);
    border-inline-start: 1px solid var(--at-divider);
    text-align: right;
  }

  .assessment-weight {
    font-weight: 700;
    font-size: var(--at-font-size-base);
    color: var(--at-primary);
  }

  .assessment-due {
    font-size: var(--at-font-size-sm);
    color: var(--at-text-secondary);
  }

  .assessment-draft {
    font-size: var(--at-font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    color: var(--at-text-secondary);
  }

  .assessment-body {
    flex: 1;
    min-width: 0;
  }

  .assessment-title {
    font-size: 1rem;
    margin: 0;
  }

  .assessment-body p {
    margin: var(--at-spacing-xs) 0 0;
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-sm);
  }

  @media (width < 640px) {
    .assessment-row {
      flex-direction: column;
      align-items: stretch;
    }

    .assessment-stat {
      flex-direction: row;
      align-items: center;
      gap: var(--at-spacing-sm);
      inline-size: auto;
      padding-inline-start: 0;
      padding-block-start: var(--at-spacing-xs);
      border-inline-start: none;
      border-block-start: 1px solid var(--at-divider);
      align-self: stretch;
      text-align: left;
    }
  }
</style>
