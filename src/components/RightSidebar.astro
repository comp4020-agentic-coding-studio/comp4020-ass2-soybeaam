---
// A right-hand panel showing the live clock/date and a current-month
// calendar. It does NOT reserve its own column in the body grid — it's a
// fixed overlay that sits on top of the content column on the right edge.
// Below the theme's own mobile breakpoint it has nowhere sensible to overlay
// from, so it clones into the theme's existing hamburger-menu dropdown
// instead of just disappearing.
//
// It carries its own open/close control — a small tab pinned to the right
// edge — rather than riding on the left sidebar's collapse toggle, so the two
// panels can be opened and closed independently.
import Icon from "astro-theme-university/components/Icon.astro";
---

<template id="right-sidebar-clock-template">
  <div class="right-sidebar-clock">
    <span class="right-sidebar-time">--:--</span>
    <span class="right-sidebar-date">&nbsp;</span>
  </div>
  <div class="right-sidebar-calendar">
    <div class="right-sidebar-calendar-title">&nbsp;</div>
    <div class="right-sidebar-calendar-weekdays">
      <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
    </div>
    <div class="right-sidebar-calendar-grid"></div>
  </div>
</template>

{/* Same CSS-only checkbox pattern the left sidebar uses. brand.css keys the
    content column's right-hand margin off `:has(.right-sidebar-toggle:checked)`,
    so opening the rail and reserving space for it stay in step with no JS. */}
<input type="checkbox" id="right-sidebar-open" class="right-sidebar-toggle" data-pagefind-ignore />

<label for="right-sidebar-open" class="right-sidebar-tab" title="Show calendar" data-pagefind-ignore>
  <Icon name="nav-arrow-left" size="1.125rem" />
  <span class="sr-only">Show or hide the calendar panel</span>
</label>

<div class="at-right-sidebar">
  <div class="right-sidebar-clock-host" data-right-sidebar-clock-host></div>
</div>

<style>
  .right-sidebar-toggle {
    position: fixed;
    inset-block-start: 0;
    inset-inline-end: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* The rail's own handle. Pinned to the right edge and vertically centred
     rather than parked in the nav bar: it has to stay reachable while the
     rail is open (so it can close it again) and it needs to sit above the
     rail's own z-index, which the nav can't. It rides inward by exactly the
     rail's width when open, so it reads as attached to the panel's edge in
     both states instead of being swallowed by it. */
  .right-sidebar-tab {
    position: fixed;
    inset-inline-end: 0;
    inset-block-start: 50%;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.75rem;
    block-size: 3.5rem;
    background: #fff;
    color: rgba(0, 0, 0, 0.55);
    border: 1px solid var(--at-divider);
    border-inline-end: none;
    border-start-start-radius: var(--at-radius-inner);
    border-end-start-radius: var(--at-radius-inner);
    box-shadow: -0.25rem 0 0.75rem rgba(0, 0, 0, 0.06);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      inset-inline-end 0.25s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .right-sidebar-tab:hover {
    background: #f3f3f3;
    color: #000;
  }

  .right-sidebar-toggle:focus-visible + .right-sidebar-tab {
    outline: 2px solid var(--at-primary);
    outline-offset: 2px;
  }

  .right-sidebar-toggle:checked + .right-sidebar-tab {
    inset-inline-end: var(--at-right-rail-width);
  }

  .right-sidebar-toggle:checked + .right-sidebar-tab :global(svg) {
    transform: rotate(180deg);
  }

  /* Fixed overlay, not a grid participant — brand.css reserves a matching
     right-hand margin on the content/nav/breadcrumb strips while this is
     open, keyed off the same checkbox. Width comes from --at-right-rail-width
     (brand.css), a token of this panel's own rather than the left sidebar's
     --at-sidebar-inset, so collapsing the left rail no longer squashes this
     one. Slides out rather than display:none-ing so the two states read as
     one panel moving, and so the content margin and the panel animate
     together. */
  .at-right-sidebar {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    width: var(--at-right-rail-width, 15rem);
    overflow-y: auto;
    /* Higher than the theme nav's z-index:100 (components.css) so the panel
       actually reads as flush with the top of the viewport instead of being
       masked by the nav bar in that top-right corner. */
    z-index: 110;
    background: #fff;
    border-inline-start: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: -0.5rem 0 1.5rem rgba(0, 0, 0, 0.08);
    padding: var(--at-spacing-md);
    transform: translateX(100%);
    visibility: hidden;
    /* `visibility` is stepped, not interpolated, so a plain duration flips it
       at the halfway point and the panel vanishes mid-slide. Delay it by the
       full transform duration on the way out (stay visible until the slide
       finishes) and fire it immediately on the way in. */
    transition:
      transform 0.25s ease,
      visibility 0s linear 0.25s;
  }

  :global(body:has(.right-sidebar-toggle:checked)) .at-right-sidebar {
    transform: translateX(0);
    visibility: visible;
    transition:
      transform 0.25s ease,
      visibility 0s;
  }

  /* No room to overlay from on a phone — the clock/calendar clones into the
     hamburger drawer instead (see script), so hide both panel and handle. */
  @media (width <= 768px) {
    .at-right-sidebar,
    .right-sidebar-tab {
      display: none;
    }
  }

  .right-sidebar-clock-host:empty {
    display: none;
  }

  :global(.right-sidebar-clock) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: var(--at-spacing-sm);
    margin-block-end: var(--at-spacing-md);
    border-radius: 0.375rem;
    background: #f7f7f7;
    font-size: var(--at-font-size-sm);
  }

  :global(.right-sidebar-time) {
    font-size: 1.375rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: #000;
  }

  :global(.right-sidebar-date) {
    color: rgba(0, 0, 0, 0.6);
    font-weight: 600;
  }

  :global(.right-sidebar-calendar) {
    font-size: var(--at-font-size-xs, 0.75rem);
  }

  :global(.right-sidebar-calendar-title) {
    font-weight: 700;
    font-size: var(--at-font-size-sm);
    color: rgba(0, 0, 0, 0.85);
    padding: 0 var(--at-spacing-xs);
    margin-block-end: var(--at-spacing-xs);
  }

  :global(.right-sidebar-calendar-weekdays),
  :global(.right-sidebar-calendar-grid) {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.125rem;
    text-align: center;
  }

  :global(.right-sidebar-calendar-weekdays span) {
    font-size: 0.65rem;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.4);
    padding-block: 0.125rem;
  }

  :global(.right-sidebar-calendar-grid span) {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.25rem;
    font-size: 0.7rem;
    color: rgba(0, 0, 0, 0.75);
  }

  :global(.right-sidebar-calendar-grid span.is-today) {
    background: var(--at-primary);
    color: var(--at-on-primary, #fff);
    font-weight: 700;
  }

  /* The clone injected into the nav's mobile dropdown (see script below)
     lands as a <li> inside `.at-nav-links`; `.at-nav-links-wrapper` is
     `display: contents` above the theme's own nav breakpoint (640px), which
     would otherwise let it render inline in the top bar itself. */
  @media (width >= 640px) {
    :global(.at-right-sidebar-mobile-item) {
      display: none;
    }
  }

  /* Calendar off on phone, clock kept. No media query needed: this clone is
     the phone-only copy (the rule above hides it from 640px up), so scoping
     to it IS scoping to phone, and the desktop rail keeps both halves.
     `:global` because the clone is built from a <template> at runtime and so
     carries no scoped `data-astro-cid-*` for a plain rule to match. */
  :global(.at-right-sidebar-mobile-item .right-sidebar-calendar) {
    display: none;
  }
</style>

<script>
  function ensureClockInstance(host: Element) {
    const template = document.getElementById("right-sidebar-clock-template") as HTMLTemplateElement | null;
    if (!template || host.childNodes.length > 0) return;
    host.append(template.content.cloneNode(true));
  }

  function ensureDesktopClock() {
    const host = document.querySelector("[data-right-sidebar-clock-host]");
    if (host) ensureClockInstance(host);
  }

  function ensureMobileClone() {
    const list = document.querySelector(".at-nav-links");
    if (!list || list.querySelector(".at-right-sidebar-mobile-item")) return;

    const template = document.getElementById("right-sidebar-clock-template") as HTMLTemplateElement | null;
    if (!template) return;

    const item = document.createElement("li");
    item.className = "at-right-sidebar-mobile-item";
    item.append(template.content.cloneNode(true));
    list.append(item);
  }

  function renderClock() {
    const now = new Date();
    const time = now.toLocaleTimeString(undefined, { hour: "2-digit", minute: "2-digit" });
    const date = now.toLocaleDateString(undefined, { weekday: "long", month: "long", day: "numeric" });

    for (const el of document.querySelectorAll(".right-sidebar-time")) {
      el.textContent = time;
    }
    for (const el of document.querySelectorAll(".right-sidebar-date")) {
      el.textContent = date;
    }
  }

  function renderCalendar() {
    const now = new Date();
    const year = now.getFullYear();
    const month = now.getMonth();
    const today = now.getDate();
    const title = now.toLocaleDateString(undefined, { month: "long", year: "numeric" });

    const firstWeekday = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    for (const titleEl of document.querySelectorAll(".right-sidebar-calendar-title")) {
      titleEl.textContent = title;
    }

    for (const gridEl of document.querySelectorAll(".right-sidebar-calendar-grid")) {
      gridEl.replaceChildren();
      for (let i = 0; i < firstWeekday; i++) {
        gridEl.append(document.createElement("span"));
      }
      for (let day = 1; day <= daysInMonth; day++) {
        const cell = document.createElement("span");
        cell.textContent = String(day);
        if (day === today) cell.classList.add("is-today");
        gridEl.append(cell);
      }
    }
  }

  // Remember whether the rail was left open, the same way the left sidebar
  // does — CSS alone can't carry checkbox state across a page navigation.
  const RAIL_KEY = "right-sidebar-open";
  function restoreRailState() {
    const toggle = document.getElementById("right-sidebar-open") as HTMLInputElement | null;
    if (!toggle || toggle.dataset.bound === "true") return;
    toggle.checked = localStorage.getItem(RAIL_KEY) === "true";
    toggle.dataset.bound = "true";
    toggle.addEventListener("change", () => {
      localStorage.setItem(RAIL_KEY, String(toggle.checked));
    });
  }

  function start() {
    restoreRailState();
    ensureDesktopClock();
    ensureMobileClone();
    renderClock();
    renderCalendar();
  }

  start();
  document.addEventListener("astro:page-load", start);

  let intervalId: ReturnType<typeof setInterval> | undefined;
  function startClockInterval() {
    if (intervalId) clearInterval(intervalId);
    intervalId = setInterval(renderClock, 15000);
  }
  startClockInterval();
  document.addEventListener("astro:page-load", startClockInterval);
</script>
