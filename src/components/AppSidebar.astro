---
// Replaces astro-theme-university's stock Sidebar: that component only
// renders a flat link list, has a fixed 16rem width, and offers no collapse
// behaviour. This one expands each top-level section into the collection's
// actual items and adds a CSS-only (no client JS) collapse toggle, while
// keeping the `.at-sidebar` wrapper as a direct child of `.at-main` so the
// theme's own grid-placement rules in sidebar.css still apply.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import Icon from "astro-theme-university/components/Icon.astro";
import { sidebarSections, siteConfig } from "../site-config";

const currentPath = Astro.url.pathname;

type Item = { label: string; week?: number; href: string };

async function itemsFor(collection?: "sessions" | "lectures" | "assessments" | "people"): Promise<Item[] | undefined> {
  if (!collection) return undefined;
  const entries = await getPublishedCollection(collection);
  if (collection === "sessions" || collection === "lectures") {
    return entries
      .slice()
      .sort((a, b) => (a.data as { week: number }).week - (b.data as { week: number }).week)
      .map((entry) => ({
        label: entry.data.title,
        week: (entry.data as { week: number }).week,
        href: withBase(`/${collection}/${entry.id}/`),
      }));
  }
  return entries
    .slice()
    .sort((a, b) => a.data.title.localeCompare(b.data.title))
    .map((entry) => ({ label: entry.data.title, href: withBase(`/${collection}/${entry.id}/`) }));
}

const sections = await Promise.all(
  sidebarSections.map(async (section) => ({
    ...section,
    href: withBase(section.href),
    items: await itemsFor(section.collection),
  })),
);

function sectionIsCurrent(sectionHref: string): boolean {
  return currentPath.startsWith(sectionHref);
}

// `logoCompact` is optional on the theme's site-config type (ours arrives via
// slopBranding). Narrow it here and fall back to a plain menu glyph, the same
// way the theme's own Nav guards it — the toggle is the only way to reopen a
// collapsed rail, so it must render an affordance even with no crest set.
const logoCompact = siteConfig.logoCompact;
---

{/* Navigation chrome, not page content: keep it out of the Pagefind index so
    the sidebar's full lecture/session listing doesn't match every query and
    leak into every search excerpt. */}
<input
  type="checkbox"
  id="sidebar-collapsed"
  class="sidebar-collapsed-toggle"
  data-pagefind-ignore
/>

<div class="at-sidebar" data-pagefind-ignore>
  {/* The crest used to BE the collapse toggle, so clicking it opened/closed
      the rail instead of going anywhere. It is a home link now, and the
      collapse control is its own separate button — which it has to be: if
      the crest merely navigated, a collapsed rail would have nothing left
      to reopen it with. */}
  <div class="sidebar-brand-row">
    <a
      href={withBase("/")}
      class="sidebar-brand"
      aria-label={`${siteConfig.name} home`}
      aria-current={currentPath === withBase("/") ? "page" : undefined}
    >
      {logoCompact && (
        <img
          src={logoCompact.src}
          width={logoCompact.width}
          height={logoCompact.height}
          alt=""
          class="sidebar-brand-logo"
        />
      )}
      <span class="sidebar-brand-name">{siteConfig.name}</span>
    </a>
    <label for="sidebar-collapsed" class="sidebar-toggle-label" title="Toggle sidebar">
      <Icon name="menu" size="1.25rem" />
      <span class="sr-only">Toggle sidebar</span>
    </label>
  </div>
  <nav aria-label="Sections">
    <ul>
      {
        sections.map((section) => (
          <li class:list={["sidebar-section", { "sidebar-divider-after": section.dividerAfter }]}>
            {section.items && section.items.length > 0 ? (
              <Fragment>
                {/* Deliberately NOT <details>/<summary>. The section title has to
                    be a real link to the section's overview page, and an <a>
                    nested inside a <summary> both navigates AND toggles the
                    disclosure — inconsistently across browsers. Splitting them
                    into an independent <a> plus a checkbox-driven <label> makes
                    "go to the section" and "show the section's pages" two
                    genuinely separate controls, and reuses the same CSS-only
                    toggle pattern as the rail collapse above (no client JS). */}
                <input
                  type="checkbox"
                  id={`sidebar-open-${section.collection}`}
                  class="sidebar-section-toggle"
                  checked={sectionIsCurrent(section.href)}
                  data-pagefind-ignore
                />
                <div class="sidebar-section-row">
                  <a
                    class="sidebar-row-label sidebar-top-link"
                    href={section.href}
                    aria-current={currentPath === section.href ? "page" : undefined}
                  >
                    <Icon name={section.icon} size="1rem" />
                    <span>{section.title}</span>
                  </a>
                  <label for={`sidebar-open-${section.collection}`} class="sidebar-disclosure">
                    <Icon name="nav-arrow-down" size="1rem" class="sidebar-chevron" />
                    <span class="sr-only">Show {section.title} pages</span>
                  </label>
                </div>
                <ul class="sidebar-items">
                  {section.items.map((item) => (
                    <li>
                      <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
                        {item.week !== undefined && <span class="sidebar-item-week">Wk {item.week}</span>}
                        <span class="sidebar-item-title">{item.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </Fragment>
            ) : (
              <a
                class="sidebar-row-label sidebar-top-link"
                href={section.href}
                aria-current={currentPath === section.href ? "page" : undefined}
              >
                <Icon name={section.icon} size="1rem" />
                <span>{section.title}</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  /* `fixed`, not `absolute`: activating the label focuses this input, and a
     browser scrolls a newly focused element into view. Anchored to the
     sidebar it sits at the sidebar's top, so every toggle yanked the page
     (and the nav list) back to the top. Anchored to the viewport it is
     already in view, so there is nothing to scroll to. */
  .sidebar-collapsed-toggle {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* The crest is centred in the rail, so the toggle is taken out of flow and
     pinned to the trailing edge — leaving it as a flex sibling would push
     the crest off-centre by half the toggle's width. */
  .sidebar-brand-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--at-spacing-xs);
    padding-block-end: var(--at-spacing-sm);
    margin-block-end: var(--at-spacing-sm);
    /* No visible bar here — the sidebar's own header should blend straight
       into the rest of the rail instead of reading as a second nav strip
       stacked on top of the site's real nav bar. */
    border-block-end: none;
    line-height: 1;
  }

  /* The toggle button IS the crest now (no separate hamburger glyph) — a
     plain, borderless hit target. Hover/press change the BACKGROUND only,
     never a transform: a scale() here made the crest visibly jump under the
     cursor on every press, and because the collapsed rail is `overflow:
     hidden` a scaled-up box also got clipped mid-animation. Background
     feedback reads as clickable without moving anything. */
  .sidebar-toggle-label {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: 50%;
    translate: 0 -50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: 0.375rem;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .sidebar-toggle-label:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  .sidebar-toggle-label:active {
    background: rgba(0, 0, 0, 0.09);
  }

  .sidebar-toggle-label:focus-visible {
    outline: 2px solid var(--at-primary);
    outline-offset: 2px;
  }

  .sidebar-brand-logo {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    flex-shrink: 0;
    vertical-align: middle;
  }

  .sidebar-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--at-spacing-xs);
    min-width: 0;
    /* Clear the pinned toggle so a long site name cannot slide under it. */
    max-inline-size: calc(100% - 2.75rem);
    padding: var(--at-spacing-xs);
    border-radius: 0.375rem;
    text-decoration: none;
    color: #000;
  }

  .sidebar-brand:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  .sidebar-brand:focus-visible {
    outline: 2px solid var(--at-primary);
    outline-offset: 2px;
  }

  .sidebar-brand-name {
    font-weight: 700;
    font-size: var(--at-font-size-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 1;
    max-width: 10rem;
    transition:
      opacity 0.2s ease,
      max-width 0.2s ease;
  }

  .sidebar-collapsed-toggle:checked ~ .at-sidebar .sidebar-brand-name {
    opacity: 0;
    max-width: 0;
  }

  /* Collapsed, the 3rem rail has ~2rem of usable track, so the home crest
     and the collapse toggle stack instead of sitting side by side. The
     toggle must stay on screen here: it is the only control that can
     reopen the rail. */
  .sidebar-collapsed-toggle:checked ~ .at-sidebar .sidebar-brand-row {
    flex-direction: column;
    justify-content: center;
    gap: var(--at-spacing-xs);
  }

  .sidebar-collapsed-toggle:checked ~ .at-sidebar .sidebar-toggle-label {
    position: static;
    translate: none;
  }

  /* Previously the whole brand link was dropped when collapsed, because it
     was only a text wordmark sitting beside the crest. It now carries the
     crest and is the home link, so it has to stay: only its text collapses
     (the rule above), and the padding is zeroed so the crest centres in the
     2rem track rather than being pushed off by its own box. */
  .sidebar-collapsed-toggle:checked ~ .at-sidebar .sidebar-brand {
    max-inline-size: none;
    padding: 0;
  }

  /* Without this, the icon+label flex row still reserves its `gap` even
     though the label span has collapsed to max-width:0 — the icon ends up
     visibly off-center by half the gap. Applies to every row shape: plain
     top-links, the row-label inside them, and <summary> for expandable
     sections. */
  .sidebar-collapsed-toggle:checked ~ .at-sidebar .sidebar-row-label,
  .sidebar-collapsed-toggle:checked ~ .at-sidebar .sidebar-top-link,
  .sidebar-collapsed-toggle:checked ~ .at-sidebar .sidebar-section-row {
    gap: 0;
  }

  .at-sidebar nav > ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .at-sidebar li + li {
    margin-block-start: var(--at-spacing-xs);
  }

  .at-sidebar a {
    display: block;
    border-radius: 0.375rem;
    padding: var(--at-spacing-xs) var(--at-spacing-sm);
    color: rgba(0, 0, 0, 0.8);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  /* Higher specificity than .at-sidebar a above, so the flex layout below
     isn't silently overridden back to block — needed for the plain
     top-level links (Home/People/Policies) that have no <details> wrapper
     and so don't go through the .at-sidebar summary flex rule instead. */
  .at-sidebar a.sidebar-top-link {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-xs);
  }

  .at-sidebar a:hover,
  .at-sidebar a:focus-visible {
    background: #f3f3f3;
    color: #000;
  }

  .at-sidebar a[aria-current="page"] {
    background: #ececec;
    color: #000;
    font-weight: 700;
  }

  /* Off-screen state holder for each expandable section. Out of flow so it
     leaves no stray row in the nav list, and `fixed` rather than `absolute`
     for the same reason as .sidebar-collapsed-toggle above: absolute put it
     at the sidebar's top, and focusing it on label activation scrolled the
     nav (and the page) back up on every expand. */
  .sidebar-section-toggle {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* Section header: the overview link takes all remaining width so the whole
     row (not just the words) is a click target for "go to the section", and
     the chevron sits at the end as its own separate control. */
  .sidebar-section-row {
    display: flex;
    align-items: center;
  }

  .at-sidebar .sidebar-section-row > a.sidebar-top-link {
    flex: 1;
    min-width: 0;
    color: rgba(0, 0, 0, 0.85);
    font-weight: 700;
  }

  .sidebar-disclosure {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .sidebar-disclosure:hover {
    background: #f3f3f3;
  }

  .sidebar-section-toggle:focus-visible + .sidebar-section-row .sidebar-disclosure {
    outline: 2px solid var(--at-primary);
    outline-offset: 1px;
  }

  /* Chevron points down when closed, flips when the section is open. */
  .sidebar-section-toggle:checked + .sidebar-section-row :global(.sidebar-chevron) {
    transform: rotate(180deg);
  }

  .sidebar-row-label {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-xs);
  }

  .sidebar-row-label :global(svg) {
    color: rgba(0, 0, 0, 0.55);
    flex-shrink: 0;
  }

  .at-sidebar a[aria-current="page"] .sidebar-row-label :global(svg) {
    color: #000;
  }

  .sidebar-top-link {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-xs);
  }

  /* :global is required here: this class is passed as a prop into the
     separate Icon.astro component, so the rendered <svg> never carries this
     file's data-astro-cid scope attribute — a bare `.sidebar-chevron`
     selector silently never matches it. */
  :global(.sidebar-chevron) {
    flex-shrink: 0;
    color: rgba(0, 0, 0, 0.4);
    opacity: 1;
    max-width: 1.25rem;
    min-width: 0;
    overflow: hidden;
    transition:
      transform 0.15s ease,
      opacity 0.15s ease,
      max-width 0.2s ease;
  }

  .sidebar-divider-after {
    padding-block-end: var(--at-spacing-sm);
    margin-block-end: var(--at-spacing-sm);
    border-block-end: 1px solid rgba(0, 0, 0, 0.08);
  }

  /* margin-block-start is 0 here and only added back by the :checked rule
     below. Left as a constant it applied even when the list was collapsed to
     max-height:0, so every icon below an open section in the collapsed rail
     was pushed down by a stray 0.25rem — the "icons move when you press
     them" effect. */
  .sidebar-items {
    list-style: none;
    margin: 0;
    padding-inline-start: var(--at-spacing-lg);
    font-size: var(--at-font-size-sm);
  }

  /* Tighter rhythm than the top-level sections, so the nested items read as
     one grouped list under their section rather than as more top-level
     entries. */
  .sidebar-items li + li {
    margin-block-start: 0;
  }

  .sidebar-items a {
    display: flex;
    align-items: center;
    gap: var(--at-spacing-xs);
    padding-block: var(--at-spacing-xs);
    color: rgba(0, 0, 0, 0.65);
    font-weight: 600;
    line-height: 1.3;
  }

  .sidebar-items a[aria-current="page"] {
    color: #000;
  }

  /* Fixed-width "Wk N" tag keeps the title column's left edge aligned down
     the whole list, instead of titles starting at varying x-positions. */
  .sidebar-item-week {
    flex-shrink: 0;
    inline-size: 2.25rem;
    color: rgba(0, 0, 0, 0.4);
    font-weight: 600;
    font-size: var(--at-font-size-sm);
  }

  .sidebar-items a[aria-current="page"] .sidebar-item-week {
    color: rgba(0, 0, 0, 0.55);
  }

  /* Collapse: shrink the sidebar to an icon-only rail instead of hiding it
     outright, so the nav stays reachable (matches the "icon rail" pattern,
     not a fully-hidden drawer). Width and the text/chevron/submenu bits all
     transition together (opacity + max-width/max-height rather than an
     instant display:none) so the rail draws in smoothly instead of the
     icons visibly snapping into their centred position after the text
     vanishes. */
  .at-sidebar {
    transition: width 0.25s ease;
  }

  .sidebar-collapsed-toggle:checked ~ .at-sidebar {
    width: 3rem;
    min-width: 3rem;
    overflow: hidden;
  }

  .sidebar-row-label span:not(:has(svg)) {
    opacity: 1;
    max-width: 10rem;
    overflow: hidden;
    white-space: nowrap;
    transition:
      opacity 0.15s ease,
      max-width 0.2s ease;
  }

  .sidebar-collapsed-toggle:checked ~ .at-sidebar .sidebar-row-label span:not(:has(svg)),
  .sidebar-collapsed-toggle:checked ~ .at-sidebar :global(.sidebar-chevron) {
    opacity: 0;
    max-width: 0;
    /* Flex items default to min-width:auto (their content's intrinsic
       size), which wins over max-width:0 and leaves a residual gap that
       throws off centering — min-width:0 lets max-width actually collapse
       it to nothing. */
    min-width: 0;
    pointer-events: none;
  }

  /* Closed is the default; the section's own checkbox opens it. */
  .sidebar-items {
    overflow: hidden;
    opacity: 0;
    max-height: 0;
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      max-height 0.25s ease,
      margin-block-start 0.25s ease;
  }

  .sidebar-section-toggle:checked ~ .sidebar-items {
    opacity: 1;
    max-height: 60rem;
    margin-block-start: var(--at-spacing-xs);
    pointer-events: auto;
  }

  /* Collapsed to an icon rail: force every section shut regardless of its own
     checkbox (three classes here vs two in the :checked rule above, so this
     wins without !important) and take back the margin with it. */
  .sidebar-collapsed-toggle:checked ~ .at-sidebar .sidebar-items {
    opacity: 0;
    max-height: 0;
    margin-block-start: 0;
    pointer-events: none;
  }

  /* The chevron has no room in a 3rem rail and its section can't open there
     anyway — drop it rather than leave a dead control squeezing the icon. */
  .sidebar-collapsed-toggle:checked ~ .at-sidebar .sidebar-disclosure {
    display: none;
  }

  .sidebar-collapsed-toggle:checked ~ .at-sidebar a {
    justify-content: center;
    padding-inline: var(--at-spacing-xs);
  }

  /* The rail is 3rem wide with var(--at-spacing-sm) (0.5rem) of padding on
     each side (brand.css), leaving 2rem of usable track — so the crest's
     2.25rem hover box overflowed it and got clipped on the right by the
     rail's `overflow: hidden`, which is why the grey box looked off-centre
     around the logo. Match the box to the track exactly. */
  .sidebar-collapsed-toggle:checked ~ .at-sidebar .sidebar-toggle-label {
    inline-size: 2rem;
    block-size: 2rem;
  }

  .sidebar-collapsed-toggle:checked ~ .at-sidebar .sidebar-divider-after {
    border-block-end: none;
    padding-block-end: 0;
  }

  :global(body:has(.sidebar-collapsed-toggle:checked)) {
    --at-sidebar-inset: 3rem;
  }

  /* Below the theme's own mobile breakpoint (sidebar.css hides .at-sidebar
     entirely at <=768px), the sidebar isn't reachable at all — so the
     collapse toggle that would otherwise open/close it shouldn't be shown
     either. */
  @media (width <= 768px) {
    .sidebar-toggle-label {
      display: none;
    }
  }
</style>

<script>
  // Remember the collapsed/open state across page loads. This is the one
  // piece of client JS the sidebar needs — CSS alone can't persist state
  // between navigations on a static site. The site runs with ClientRouter
  // (view transitions) on, which swaps in a fresh, unchecked checkbox on
  // every navigation — so this has to re-run on `astro:page-load`, the same
  // way RightSidebar's own rail-state restore does, not just once at
  // first load.
  const STORAGE_KEY = "sidebar-collapsed";

  function restoreSidebarState() {
    const toggle = document.getElementById("sidebar-collapsed") as HTMLInputElement | null;
    if (!toggle || toggle.dataset.bound === "true") return;
    toggle.dataset.bound = "true";

    toggle.checked = localStorage.getItem(STORAGE_KEY) === "true";
    toggle.addEventListener("change", () => {
      localStorage.setItem(STORAGE_KEY, String(toggle.checked));
    });
  }

  restoreSidebarState();
  document.addEventListener("astro:page-load", restoreSidebarState);
</script>
