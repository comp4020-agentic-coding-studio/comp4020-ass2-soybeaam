---
import ContentLayout, { type ContentLayoutProps } from "astro-theme-university/layouts/ContentLayout.astro";
import "astro-theme-university/styles/sidebar.css";
import AppSidebar from "../components/AppSidebar.astro";

type Props = ContentLayoutProps;
---

<ContentLayout {...Astro.props}>
  <slot name="head" slot="head" />
  <AppSidebar />
  <div class="at-sidebar-content">
    <slot />
  </div>
</ContentLayout>
